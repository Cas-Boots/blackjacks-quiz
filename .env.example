# Wat de uitrol nodig heeft. In Dokploy vul je dit in onder Environment;
# lokaal kopieer je dit bestand naar `.env` naast de docker-compose.yml.
#
# Let op: dit bestand hoort in git, `.env` niet.

# De pincode waarmee de quizmaster het hostscherm opent. Verzin een eigen code.
# Zonder deze regel, of met de voorbeeldcode 2627 uit het README, weigert de
# container gezond te worden.
HOST_PIN=

# Het volledige adres waarop de quiz te bereiken is, zonder slash aan het eind.
ORIGIN=https://quiz.deblackjacks.nl

# De cijfers van het jaar, live uit resolution-recap. Het adres van die app,
# zonder /api/export erachter, en het BACKUP_TOKEN van dat project (minstens
# 32 tekens). Laat je ze leeg, dan draait de quiz op de ingebouwde
# momentopname.
# Bijvoorbeeld: RECAP_URL=https://resolution-recap.avs-api.nl
RECAP_URL=
RECAP_TOKEN=
# Hoe vaak de quiz de cijfers ververst, in seconden (minimaal 15; 0 zet het
# uit). Tijdens een ronde die de cijfers gebruikt wacht hij tot die voorbij is.
RECAP_INTERVAL=60
