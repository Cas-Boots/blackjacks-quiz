# Wat de uitrol nodig heeft. In Dokploy vul je dit in onder Environment;
# lokaal kopieer je dit bestand naar `.env` naast de docker-compose.yml.
#
# Let op: dit bestand hoort in git, `.env` niet.

# De pincode waarmee de quizmaster het hostscherm opent. Verzin een eigen code.
# Zonder deze regel, of met de voorbeeldcode 2627 uit het README, weigert de
# container gezond te worden.
HOST_PIN=

# Het volledige adres waarop de quiz te bereiken is, zonder slash aan het eind.
ORIGIN=https://deblackjacks.nl
